  "clinical_rules": [
    {
      "id": "rule_dr_hypertension_urgency",
      "description": "Hypertensive diabetic patients with any referable DR should be managed with BP < 130/80 to slow progression.",
      "trigger": {"findings": ["diabetes_risk", "diabetic_retinopathy"], "conditions": ["hypertension"]},
      "action": "Elevate BP control recommendation to urgent; target < 130/80 mmHg."
    },
    {
      "id": "rule_melanoma_urgent_referral",
      "description": "Any model confidence ≥ 0.40 for Melanoma or SCC warrants urgent dermatology referral regardless of confidence threshold.",
      "trigger": {"skin_label": ["Melanoma", "Squamous cell carcinoma"]},
      "action": "Flag ALERT; recommend urgent biopsy within 2 weeks."
    },
    {
      "id": "rule_proliferative_dr_emergency",
      "description": "Grade 4 (Proliferative DR) is a sight-threatening emergency requiring ophthalmology within days.",
      "trigger": {"dr_grade": 4},
      "action": "Flag ALERT; recommend ophthalmology within 1–4 weeks depending on visual symptoms."
    },
    {
      "id": "rule_high_glucose_diabetes",
      "description": "Glucose ≥ 200 mg/dL combined with a positive diabetes prediction is highly specific for DM.",
      "trigger": {"tabular": {"Glucose": {"gte": 200}}, "diabetes_positive": true},
      "action": "Recommend urgent fasting glucose / HbA1c confirmation."
    }
  ]
